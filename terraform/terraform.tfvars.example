# Copy to terraform.tfvars (git-ignored) and adjust. Credentials never go in this file:
# Terraform uses the AWS CLI login (export AWS_PROFILE=readcycle).
owner               = "Your Name"
aws_region          = "ap-southeast-2" # the region AWS assigned to the account
cluster_version     = "1.37"
node_instance_types = ["m7i-flex.large"] # Free plan: Free Tier eligible types only
api_allowed_cidrs   = ["203.0.113.10/32"] # your own public IP: curl https://checkip.amazonaws.com
